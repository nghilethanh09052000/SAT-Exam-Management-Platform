# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=sat-pipeline

# Scraper — Bluebooky
BLUEBOOKY_BASE_URL=https://bluebooky.com

# Scraper — SatGPT (requires login)
SATGPT_BASE_URL=https://www.satgpt.xyz
SATGPT_EMAIL=your@email.com
SATGPT_PASSWORD=yourpassword

# Shared scraper settings
SCRAPER_CONCURRENCY=3
SCRAPER_DELAY_SECONDS=1.5

# GCS (Flow 1 — raw layer)
GCS_BUCKET=sat-pipeline-raw
GCS_RAW_PREFIX=raw
GCS_EXPORT_PREFIX=exports
GCS_SIGNED_URL_EXPIRY_HOURS=24

# BigQuery (Flow 1 — ingest + transform)
BQ_PROJECT_ID=your-gcp-project-id
BQ_RAW_DATASET=sat_raw
BQ_CLEAN_DATASET=sat_clean
BQ_LOCATION=US

# ClickHouse (Flow 2 — sync)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=sat_raw
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# App DB — PostgreSQL (Flow 2 — sync)
APP_DB_DSN=postgresql+asyncpg://user:password@localhost:5432/sat_app

# dbt
DBT_PROJECT_DIR=./dbt
DBT_PROFILES_DIR=./dbt
DBT_TARGET=bigquery

# API server
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=
